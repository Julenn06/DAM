public class Main extends JFrame {

	private static final long serialVersionUID = 1L;
	private JPanel contentPane;
	ArrayList<Mensajes> mensaje = new ArrayList<>();
	Mensajes mensajes;

	public static void main(String[] args) {
		EventQueue.invokeLater(new Runnable() {
			public void run() {
				try {
					Main frame = new Main();
					frame.setVisible(true);
				} catch (Exception e) {
					e.printStackTrace();
				}
			}
		});
	}

	public Main() {
		setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
		setBounds(100, 100, 800, 600);
		contentPane = new JPanel();
		contentPane.setBorder(new EmptyBorder(5, 5, 5, 5));
		setContentPane(contentPane);
		contentPane.setLayout(null);

		JButton enviarMensaje = new JButton("Enviar mensaje");
		enviarMensaje.addActionListener(new ActionListener() {
			public void actionPerformed(ActionEvent e) {
				// Cambiado a 4 filas en el GridLayout ya que tienes 4 campos de texto
				JPanel panelDatos = new JPanel();
				panelDatos.setLayout(new GridLayout(4, 2));

				panelDatos.add(new JLabel("Quien manda:"));
				JTextField txtQuienManda = new JTextField(10);
				panelDatos.add(txtQuienManda);

				panelDatos.add(new JLabel("Quien recibe:"));
				JTextField txtQuienRecibe = new JTextField(10);
				panelDatos.add(txtQuienRecibe);

				panelDatos.add(new JLabel("asunto:"));
				JTextField txtAsunto = new JTextField(10);
				panelDatos.add(txtAsunto);

				panelDatos.add(new JLabel("contenido:"));
				JTextField txtContenido = new JTextField(10);
				panelDatos.add(txtContenido);

				int result = JOptionPane.showConfirmDialog(null, panelDatos, "Introduce tus datos",
						JOptionPane.OK_CANCEL_OPTION);

				if (result == JOptionPane.OK_OPTION) {
					try {
						String userManda = txtQuienManda.getText();
						String userRecibe = txtQuienRecibe.getText();
						String asunto = txtAsunto.getText();
						String contenido = txtContenido.getText();

						// Obtener fecha y hora actuales
						LocalDate fechaAhora = LocalDate.now();
						LocalTime horaAhora = LocalTime.now();

						// Definir los formateadores específicos
						DateTimeFormatter formateadorFecha = DateTimeFormatter.ofPattern("yyyy-MM-dd");
						DateTimeFormatter formateadorHora = DateTimeFormatter.ofPattern("HH:mm:ss"); // "SS" añade
																										// los 2
																										// decimales

						// Convertir a cadena de texto con formato
						String fechaFormateada = fechaAhora.format(formateadorFecha);
						String horaFormateada = horaAhora.format(formateadorHora);

						/*
						 * mensajes.setUserEnviar(userManda); mensajes.setUserRecibir(userRecibe);
						 * mensajes.setAsunto(asunto); mensajes.setContenido(contenido);
						 * mensajes.setFecha(fechaAhora); mensajes.setHora(horaAhora);
						 * 
						 * mensaje.add(mensajes);
						 */

						try (BufferedWriter writer = new BufferedWriter(new FileWriter("users.txt", true))) {
							// Escribir las variables formateadas como texto limpio en el fichero
							writer.write("fecha: " + fechaFormateada + "\n" + "hora: " + horaFormateada + "\n"
									+ "para: " + userRecibe + "\n" + "de: " + userManda + "\n" + "asunto: " + asunto
									+ "\n" + "contenido: " + contenido + "\n"
									+ "*************************************");
							writer.newLine();
						} catch (Exception ex) {
							JOptionPane.showMessageDialog(null, "Error enviando el mensaje: " + ex.getMessage());
						}
					} catch (NumberFormatException ex) {
						JOptionPane.showMessageDialog(null, "Invalid age or salary format.");
					}
				}

			}
		});

		enviarMensaje.setBounds(180, 82, 110, 93);
		contentPane.add(enviarMensaje);

		JButton guardarMensajes = new JButton("Guardar Mensajes");
		guardarMensajes.addActionListener(new ActionListener() {
			public void actionPerformed(ActionEvent e) {
				ReadFile reader = new ReadFile();
				reader.MostrarFichero();
			}
		});
		guardarMensajes.setBounds(557, 82, 110, 93);
		contentPane.add(guardarMensajes);

		JButton añadirMensaje = new JButton("Añadir Mensaje");
		añadirMensaje.addActionListener(new ActionListener() {
			public void actionPerformed(ActionEvent e) {
				ReadFile reader = new ReadFile();
				reader.MostrarFichero();

			}
		});
		añadirMensaje.setBounds(180, 315, 110, 93);
		contentPane.add(añadirMensaje);

		JButton imprimirMensaje = new JButton("Imprimir Mensaje");
		imprimirMensaje.setBounds(557, 315, 110, 93);
		contentPane.add(imprimirMensaje);
	}
}
